{
  "name": "figma-plugin-react",
  "version": "1.0.0",
  "description": "Figma plugin with React and Vite",
  "type": "module",
  "main": "dist/code.js",
  "scripts": {
    "build": "npm run build:ui && npm run build:main",
    "build:main": "esbuild src/main/code.ts --bundle --outfile=dist/code.js --target=es6",
    "build:ui": "vite build --emptyOutDir=false",
    "watch": "npm run build:ui -- --watch & npm run build:main -- --watch"
  },
  "license": "ISC",
  "devDependencies": {
    "@figma/plugin-typings": "^1.84.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^5.1.4",
    "esbuild": "^0.19.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vite-plugin-singlefile": "^2.0.0"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  }
}